<% layout("/layouts/boilerplate") %>
<body>
    <h2><%= compData.title %></h2>
    <p><%= compData.description %></p>
    <p>₹ <%= compData.price.toLocaleString('en-IN') %></p>
    <img src="<%= compData.image.url %>" alt="<%= compData.title %>" width="800px">
    <br><br><br>
    
    <form method = "GET" action="/listings/<%= compData._id %>/edit">
        <button>Edit Info</button>
    </form>
    <br><br>
    <form method = "POST" action="/listings/<%= compData._id %>?_method=DELETE">
        <button>Delete Listing</button>
    </form>
</body>