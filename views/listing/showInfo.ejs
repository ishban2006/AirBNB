<% layout("/layouts/boilerplate") %>
    <br><br>
    <div class="row">
        <div class="col-8 offset-3 mt-4">
            <h2><b><%= compData.title %></b></h2>
        </div>
        <div class="card col-10 col-md-6 mx-auto">
            <img src="<%= compData.image.url %>" class="card-img-top show-img" alt="<%= compData.title %>">
            <div class="card-body mt-3">
                <p class="card-text">
                    <%= compData.description %><br>
                    <%= compData.location %><br>
                    <%= compData.country %><br>
                    ₹ <%= compData.price.toLocaleString('en-IN') %>
                </p>
                <div class="btns flex-column flex-md-row">
                    <div>
                        <form method = "GET" action="/listings/<%= compData._id %>/edit">
                            <button class="btn btn-primary mt-3">Edit Information</button>
                        </form>
                    </div>
                    <div>
                        <form method = "POST" action="/listings/<%= compData._id %>?_method=DELETE" 
                            onsubmit="return confirm('Are you sure you want to delete this listing?')">
                            <button class="btn btn-danger mt-3">Delete Listing</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-8 offset-3 mt-4 mb-5">
            <hr>
            <h3>Leave a Review</h3>
            <form method="POST" action="/listings/<%= compData._id %>/reviews" class="needs-validation" novalidate>
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Add Rating</label>
                    <input type="range" class="form-range" id="rating" name="review[rating]" min="1" max="5" required>
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Your Review</label>
                    <textarea class="form-control" id="comment" name="review[comment]" rows="3" required></textarea>
                    <div class="invalid-feedback">
                        Please enter a review.
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>

            <hr>
            <h3>Reviews</h3>
            <br>
            <% if (compData.reviews.length === 0) { %>
                <p>No reviews yet. Be the first to review this listing!</p>
            <% } else { %>
                <div class="row">
                    <% compData.reviews.forEach(review => { %>
                        <div class="card col-5 ms-3 mb-3 brd">
                            <div class="card-body p-2 d-flex flex-column">
                                <h5 class="card-title">Rating: <%= review.rating %> / 5 ⭐️</h5>
                                <p class="card-text"><%= review.comment %></p>

                                <form class="mt-auto" method="POST" action="/listings/<%= compData._id %>/reviews/<%= review._id %>?_method=DELETE" 
                                    onsubmit="return confirm('Are you sure you want to delete this review?')">
                                    <button class="btn btn-danger">Delete Review</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>