<% layout("/layouts/boilerplate") %>
<body>
    <h2> Edit Your Listing</h2>
    <form method="POST" action="/listings/<%= compData._id %>?_method=PUT">     <!-- PUT overrides POST -->
        <label for="title">Title:</label><br>
        <input type="text" value = "<%= compData.title %>" name="listing[title]"><br><br>

        <label for="description">Description:</label><br>
        <textarea name="listing[description]" rows="4" cols="50"><%= compData.description %></textarea><br><br>

        <label for="imageUrl">Image URL:</label><br>
        <input type="text" value = "<%= compData.image.url %>" name="listing[image][url]"><br><br>

        <label for="price">Price (₹):</label><br>
        <input type="number" value = "<%= compData.price %>" id="price" name="listing[price]" required><br><br>

        <label for="location">Location:</label><br>
        <input type="text" value = "<%= compData.location %>" id="location" name="listing[location]" required><br><br>

        <label for="country">Country:</label><br>
        <input type="text" value = "<%= compData.country %>" id="country" name="listing[country]"><br><br>

        <button type="submit">Edit Information</button>
    </form>
