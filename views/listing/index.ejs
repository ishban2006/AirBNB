<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AirBnB</title>
</head>
<body>
    <h3>AirBnB</h3>
    <ul>
        <% for (let elem of allListings) { %>
            <li><a href="/listings/<%= elem._id %>"><%= elem.title %></a></li>  <!-- Info about the listing -->
            <li><%= elem.description %></li>
            <img src="<%= elem.image.url %>" alt="<%= elem.title %>" width="400px">
            <hr>
        <% } %>
    </ul>
</body>
</html>