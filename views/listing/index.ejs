<% layout("/layouts/boilerplate") %>
<body>
    <h3>AirBnB</h3>
    <ul>
        <% for (let elem of allListings) { %>
            <li><a href="/listings/<%= elem._id %>"><%= elem.title %></a></li>  <!-- Info about the listing -->
            <li><%= elem.description %></li>
            <img src="<%= elem.image.url %>" alt="<%= elem.title %>" width="200px">
            <hr>
        <% } %>
    </ul>

    <form method="GET" action="/listings/createNew">
        <button>Create New Listing</button>
    </form>
</body>
